# ==============================================================
# WhatsApp Broadcasting Platform - environment configuration
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.
# ==============================================================

# --- Core server ---
NODE_ENV=production
PORT=5000

# Public URL of the deployed site (no trailing slash).
# Must exactly match a "Valid OAuth Redirect URI" host on your Meta App,
# and is used to build the Facebook Login callback URL: {APP_URL}/api/callback
APP_URL=https://yourdomain.com

# --- Database (Neon Postgres, or any Postgres connection string) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Sessions ---
# Any long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Meta / Facebook App ---
# From https://developers.facebook.com -> Your App -> App Settings > Basic
# Used both for "Log in with Facebook" (website login) and for the
# WhatsApp Business embedded signup / OAuth connect flow.
FACEBOOK_APP_ID=your-meta-app-id
FACEBOOK_APP_SECRET=your-meta-app-secret

# --- Razorpay (subscription billing) ---
# From https://dashboard.razorpay.com -> Settings -> API Keys
# Use Test Mode keys until you're ready to accept real payments.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# From Settings -> Webhooks, after adding {APP_URL}/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Cloudflare R2 (uploaded media storage) ---
# Optional. If any of these are missing, uploaded template/campaign media
# falls back to being stored as base64 in Postgres (the old behavior) -
# the app works fine either way, R2 just avoids buffering large files in
# server memory and keeps them out of the database.
# 1. Cloudflare dashboard -> R2 Object Storage -> create a bucket.
# 2. Copy the Account ID shown on the R2 overview page.
# 3. R2 -> Manage R2 API Tokens -> Create API Token, scoped to
#    "Object Read & Write" on just that bucket (not account-wide).
#    Leave the bucket private - the app serves all media itself through
#    /uploads/db/<id>, so R2 never needs public access enabled.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Emergency kill-switch: set to "postgres" to force all new uploads back
# to the database without touching the R2 credentials above.
UPLOAD_STORAGE_BACKEND=r2
